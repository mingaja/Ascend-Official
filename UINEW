  local Tabs = {}
  local CountTab = 0

  function Tabs:CreateTab(Config)
    local _Name = Config[1] or Config.Name or "" 
    local Icon = Config[2] or Config.Icon or "rbxassetid://111882698376264"
    
    local ScrolLayers = Custom:Create("ScrollingFrame", {
      ScrollBarThickness = 0,
      Active = true,
      LayoutOrder = CountTab,
      BackgroundTransparency = 0.999,
      Size = UDim2.new(1, 0, 1, 0),
      Parent = LayersFolder
    })

    Custom:Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, ScrolLayers)

    local Tab = Custom:Create("Frame", {
      BackgroundColor3 = Custom.ColorRGB,
      BackgroundTransparency = CountTab == 0 and 0.85 or 0.999,
      LayoutOrder = CountTab,
      Size = UDim2.new(1, 0, 0, 32),
      Parent = ScrollTab
    })

    Custom:Create("UICorner", { CornerRadius = UDim.new(0, 6) }, Tab)

    local TabButton = Custom:Create("TextButton", {
      Text = "",
      BackgroundTransparency = 0.999,
      Size = UDim2.new(1, 0, 1, 0),
      Parent = Tab
    })

    Custom:Create("TextLabel", {
      Font = Enum.Font.GothamBold,
      Text = _Name,
      TextColor3 = Color3.fromRGB(255, 255, 255),
      TextSize = 12,
      TextXAlignment = Enum.TextXAlignment.Left,
      BackgroundTransparency = 0.999,
      Position = UDim2.new(0, 32, 0, 0),
      Size = UDim2.new(1, -35, 1, 0),
      Parent = Tab
    })

    Custom:Create("ImageLabel", {
      Image = Icon,
      BackgroundTransparency = 0.999,
      Position = UDim2.new(0, 8, 0, 8),
      Size = UDim2.fromOffset(16, 16),
      Parent = Tab
    })

    if CountTab == 0 then
      LayersPageLayout:JumpToIndex(0)
      NameTab.Text = _Name
    end

    TabButton.Activated:Connect(function()
      CircleClick(TabButton, Player:GetMouse().X, Player:GetMouse().Y)
      for _, TabFrame in pairs(ScrollTab:GetChildren()) do
        if TabFrame.Name == "Tab" then
          TweenService:Create(TabFrame, TweenInfo.new(0.2), {BackgroundTransparency = 0.999}):Play()
        end
      end
      TweenService:Create(Tab, TweenInfo.new(0.2), {BackgroundTransparency = 0.85}):Play()
      LayersPageLayout:JumpToIndex(Tab.LayoutOrder)
      NameTab.Text = _Name
    end)

    local Sections = {}
    function Sections:AddSection(Title)
      local SectionAdd = Custom:Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(25, 28, 42),
        BackgroundTransparency = 0.3,
        Size = UDim2.new(1, 0, 0, 100),
        Parent = ScrolLayers
      })

      Custom:Create("UICorner", { CornerRadius = UDim.new(0, 6) }, SectionAdd)
      Custom:Create("UIStroke", { Color = Custom.ColorRGB, Thickness = 0.8, Transparency = 0.5 }, SectionAdd)

      Custom:Create("TextLabel", {
        Font = Enum.Font.GothamBold,
        Text = Title or "Section",
        TextColor3 = Custom.YellowRGB,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 8),
        Size = UDim2.new(1, -20, 0, 20),
        Parent = SectionAdd
      })

      local Container = Custom:Create("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 8, 0, 32),
        Size = UDim2.new(1, -16, 1, -38),
        Parent = SectionAdd
      })

      Custom:Create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, Container)

      Container.ChildAdded:Connect(function()
        local totalY = 38
        for _, child in pairs(Container:GetChildren()) do
          if child:IsA("GuiObject") then
            totalY = totalY + child.AbsoluteSize.Y + 5
          end
        end
        SectionAdd.Size = UDim2.new(1, 0, 0, totalY)
      end)

      local Items = {}
      function Items:AddButton(Config)
        local Title = Config[1] or Config.Title or "Button"
        local Callback = Config[3] or Config.Callback or function() end

        local Btn = Custom:Create("TextButton", {
          Font = Enum.Font.GothamBold,
          Text = "  " .. Title,
          TextColor3 = Color3.fromRGB(240, 240, 240),
          TextSize = 12,
          TextXAlignment = Enum.TextXAlignment.Left,
          BackgroundColor3 = Color3.fromRGB(35, 40, 60),
          Size = UDim2.new(1, 0, 0, 30),
          Parent = Container
        })
        Custom:Create("UICorner", { CornerRadius = UDim.new(0, 4) }, Btn)

        Btn.Activated:Connect(function()
          CircleClick(Btn, Player:GetMouse().X, Player:GetMouse().Y)
          Callback()
        end)
      end

      function Items:AddToggle(Config)
        local Title = Config[1] or Config.Title or "Toggle"
        local Default = Config[3] or Config.Default or false
        local Callback = Config[4] or Config.Callback or function() end

        local toggled = Default
        local Tgl = Custom:Create("TextButton", {
          Font = Enum.Font.GothamBold,
          Text = "  " .. Title,
          TextColor3 = Color3.fromRGB(240, 240, 240),
          TextSize = 12,
          TextXAlignment = Enum.TextXAlignment.Left,
          BackgroundColor3 = Color3.fromRGB(35, 40, 60),
          Size = UDim2.new(1, 0, 0, 30),
          Parent = Container
        })
        Custom:Create("UICorner", { CornerRadius = UDim.new(0, 4) }, Tgl)

        local Indicator = Custom:Create("Frame", {
          BackgroundColor3 = toggled and Custom.ColorRGB or Color3.fromRGB(80, 80, 90),
          AnchorPoint = Vector2.new(1, 0.5),
          Position = UDim2.new(1, -8, 0.5, 0),
          Size = UDim2.fromOffset(36, 18),
          Parent = Tgl
        })
        Custom:Create("UICorner", { CornerRadius = UDim.new(1, 0) }, Indicator)

        local Circle = Custom:Create("Frame", {
          BackgroundColor3 = Color3.fromRGB(255, 255, 255),
          Position = toggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
          Size = UDim2.fromOffset(14, 14),
          Parent = Indicator
        })
        Custom:Create("UICorner", { CornerRadius = UDim.new(1, 0) }, Circle)

        Tgl.Activated:Connect(function()
          CircleClick(Tgl, Player:GetMouse().X, Player:GetMouse().Y)
          toggled = not toggled
          Callback(toggled)
          TweenService:Create(Indicator, TweenInfo.new(0.2), {BackgroundColor3 = toggled and Custom.ColorRGB or Color3.fromRGB(80, 80, 90)}):Play()
          TweenService:Create(Circle, TweenInfo.new(0.2), {Position = toggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}):Play()
        end)
      end

      return Items
    end
    CountTab = CountTab + 1
    return Sections
  end
  return Tabs
end


